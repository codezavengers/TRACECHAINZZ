# TRACECHAIN environment variables.
#
# Copy this file to .env.local and fill in only the values you have.
# DIRECT-NODE ARCHITECTURE:
# - EVM chains connect to native JSON-RPC nodes directly (public RPCs provided by default).
# - Bitcoin connects to a native Bitcoin Core JSON-RPC node via BITCOIN_RPC_URL.
# - Solana connects to native Solana JSON-RPC directly.
# - TRON connects to official TRON node infrastructure (TronGrid).
# No third-party explorer or indexer APIs are used in the production LIVE path.
# Never commit a filled-in .env or .env.local.

# ---------------------------------------------------------------------------
# Bitcoin Core Node (JSON-RPC)
# ---------------------------------------------------------------------------
# Set BITCOIN_RPC_URL to your Bitcoin Core RPC endpoint (e.g., http://localhost:8332 or a node provider).
# Set BITCOIN_RPC_USER and BITCOIN_RPC_PASSWORD if authentication is enabled.
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# ---------------------------------------------------------------------------
# EVM Chains (Ethereum, Polygon, BSC, Arbitrum, Optimism, Base, Avalanche)
# ---------------------------------------------------------------------------
# Public keyless JSON-RPC endpoints are configured by default for read operations.
# Override per chain with your dedicated or private node/archive endpoints:
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
AVALANCHE_RPC_URL=

# Legacy env var aliases supported for backward compatibility:
TRACECHAIN_ETH_API_URL=
TRACECHAIN_POLYGON_API_URL=
TRACECHAIN_BSC_API_URL=
TRACECHAIN_ARBITRUM_API_URL=
TRACECHAIN_OPTIMISM_API_URL=
TRACECHAIN_BASE_API_URL=
TRACECHAIN_AVALANCHE_API_URL=

# ---------------------------------------------------------------------------
# Solana Native JSON-RPC
# ---------------------------------------------------------------------------
# Defaults to public mainnet-beta (https://api.mainnet-beta.solana.com).
# Override with a private Solana RPC endpoint for high-throughput investigations:
SOLANA_RPC_URL=
TRACECHAIN_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# TRON Native Infrastructure (TronGrid)
# ---------------------------------------------------------------------------
# Defaults to official TronGrid REST infrastructure (https://api.trongrid.io).
# Set TRACECHAIN_TRON_API_KEY for a higher rate limit tier (optional).
TRON_RPC_URL=
TRACECHAIN_TRON_API_KEY=

# ---------------------------------------------------------------------------
# USD Price Enrichment (CoinGecko / Binance)
# ---------------------------------------------------------------------------
# Free public CoinGecko / Binance feeds are supported out of the box.
TRACECHAIN_PRICE_API_URL=
TRACECHAIN_PRICE_API_KEY=

# ---------------------------------------------------------------------------
# Persistent Investigation Storage (PostgreSQL)
# ---------------------------------------------------------------------------
# DATABASE_URL selects the persistence backend.
# If configured -> PostgreSQL persistent storage (ProductionDatabase)
# If unconfigured -> In-memory development database (surfaced as IN_MEMORY)
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI & Forensics (Gemini API)
# ---------------------------------------------------------------------------
# Injected at runtime by AI Studio or set manually for server-side case briefings.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signing secret for session JWTs. Set a strong random secret before deployment.
TRACECHAIN_JWT_SECRET=
